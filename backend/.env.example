APP_NAME="Mini App Financas"
APP_ENV="local"
PYDANTIC_DISABLE_PLUGINS=1

GMAIL_IMAP_HOST="imap.gmail.com"
GMAIL_IMAP_PORT=993

BRUNO_EMAIL="seu-email@gmail.com"
BRUNO_EMAIL_APP_PASSWORD="sua-senha-de-app"

MAYARA_EMAIL="email-da-mayara@gmail.com"
MAYARA_EMAIL_APP_PASSWORD="senha-de-app-da-mayara"

NUBANK_GMAIL_QUERY='(from:nubank OR from:nubank.com.br OR subject:Nubank) newer_than:180d'
NUBANK_STATEMENT_SUBJECT="Extrato da fatura do Cartão Nubank"
NUBANK_EMAIL_LIMIT=20
